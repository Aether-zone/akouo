{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.app.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@akouo/ai$": "<rootDir>/libs/ai/src",
    "^@akouo/ai/(.*)$": "<rootDir>/libs/ai/src/$1",
    "^@akouo/common$": "<rootDir>/libs/common/src",
    "^@akouo/common/(.*)$": "<rootDir>/libs/common/src/$1",
    "^@akouo/embedding$": "<rootDir>/libs/embedding/src",
    "^@akouo/embedding/(.*)$": "<rootDir>/libs/embedding/src/$1",
    "^@akouo/extraction$": "<rootDir>/libs/extraction/src",
    "^@akouo/extraction/(.*)$": "<rootDir>/libs/extraction/src/$1",
    "^@akouo/location$": "<rootDir>/libs/location/src",
    "^@akouo/location/(.*)$": "<rootDir>/libs/location/src/$1",
    "^@akouo/meeting$": "<rootDir>/libs/meeting/src",
    "^@akouo/meeting/(.*)$": "<rootDir>/libs/meeting/src/$1",
    "^@akouo/person$": "<rootDir>/libs/person/src",
    "^@akouo/person/(.*)$": "<rootDir>/libs/person/src/$1",
    "^@akouo/recording$": "<rootDir>/libs/recording/src",
    "^@akouo/recording/(.*)$": "<rootDir>/libs/recording/src/$1",
    "^@akouo/search$": "<rootDir>/libs/search/src",
    "^@akouo/search/(.*)$": "<rootDir>/libs/search/src/$1",
    "^@akouo/template$": "<rootDir>/libs/template/src",
    "^@akouo/template/(.*)$": "<rootDir>/libs/template/src/$1",
    "^@akouo/transcription$": "<rootDir>/libs/transcription/src",
    "^@akouo/transcription/(.*)$": "<rootDir>/libs/transcription/src/$1"
  },
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/dist/",
    "/test/"
  ]
}
